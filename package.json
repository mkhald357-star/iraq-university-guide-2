{
  "name": "iraq-university-guide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run build-hierarchy && npm run build-major-offerings && npm run build-major-admission-index && npm run build-major-profiles && npm run build-major-skills && npm run build-major-projects && npm run build-major-context && npm run compute-homepage-stats",
    "dev": "next dev -p 3000",
    "prebuild": "npm run build-hierarchy && npm run build-major-offerings && npm run build-major-admission-index && npm run build-major-profiles && npm run build-major-skills && npm run build-major-projects && npm run build-major-context && npm run compute-homepage-stats && npm run validate-data",
    "build": "next build",
    "postbuild": "node scripts/security/postbuild.mjs",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate-data": "node scripts/validate-data.js",
    "extract-pdf-text": "node scripts/extract-pdf-text.js",
    "parse-cutoffs": "node scripts/parse-cutoffs.js",
    "parse-evening-study": "node scripts/parse-evening-study.js",
    "parse-chapter3-branches": "node scripts/parse-chapter3-branches.js",
    "build-universities-data": "node scripts/build-universities-data.js && node scripts/derive-private-branches.js",
    "build-major-offerings": "node scripts/build-major-offerings.js",
    "build-hierarchy": "node scripts/build-hierarchy-data.js",
    "build-major-profiles": "node scripts/build-major-profiles.js",
    "build-major-skills": "node scripts/build-major-skills.js",
    "build-major-projects": "node scripts/build-major-projects.js",
    "build-major-context": "node scripts/build-major-context.js",
    "compute-homepage-stats": "node scripts/compute-homepage-stats.js",
    "og": "node scripts/generate-og-image.js",
    "personas": "node scripts/run-personas.js",
    "a11y-check": "node scripts/a11y-check.js",
    "snapshot": "node scripts/generate-project-snapshot.js",
    "rebuild-data": "npm run extract-pdf-text && npm run parse-cutoffs && npm run parse-evening-study && npm run parse-chapter3-branches && npm run build-universities-data && npm run build-major-offerings && npm run build-major-admission-index && npm run build-major-profiles && npm run build-major-skills && npm run build-major-projects && npm run build-major-context && npm run compute-homepage-stats && npm run validate-data",
    "build-major-admission-index": "node scripts/build-major-admission-index.js"
  },
  "dependencies": {
    "lucide-react": "^1.68.0",
    "next": "^15.5.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.2",
    "eslint": "^8",
    "eslint-config-next": "^15.5.27",
    "eslint-config-prettier": "^10.1.8",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.64.1",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.30"
  }
}
